# AI-antwoord op /zoeken (open-source model via Groq's OpenAI-compatible API).
# Zonder deze key blijft de rest van de site gewoon werken; het AI-antwoordblok
# toont dan een nette "niet geconfigureerd"-melding in plaats van te crashen.
# Maak een gratis key aan op console.groq.com.
GROQ_API_KEY=

# De productie-domeinnaam van de site (geen slash op het einde). Sitemap.xml,
# robots.txt, canonical URLs en alle JSON-LD structured data gebruiken dit.
# Ontbreekt deze variabele, dan valt de site stil terug op http://localhost:3000
# — controleer dit dus altijd in de Vercel-projectinstellingen na een deploy.
NEXT_PUBLIC_SITE_URL=

# Nieuwsbrief (Resend). Zonder deze vier variabelen blijft de rest van de site
# gewoon werken; het inschrijfformulier toont dan een "niet geconfigureerd"-
# melding. Zie src/lib/newsletter.ts voor de exacte vereisten.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_FROM_EMAIL=
NEWSLETTER_CONFIRM_SECRET=

# Beveiligt /api/newsletter/send-broadcast (de tweewekelijkse nieuwsbrief-
# verzending): enkel bedoeld om vanuit de nieuwsbrief-agent aangeroepen te
# worden, na expliciete goedkeuring. Willekeurige lange string.
NEWSLETTER_ADMIN_SECRET=
