# Copy to .env and fill in, OR set these as the "env" block of this
# server's entry in your MCP client config (recommended — see README.md).
# Never commit a filled-in .env.

# --- Guardrails ---
AUTOBROKER_MAX_PER_ORDER_EUR=250
AUTOBROKER_MAX_PER_MONTH_EUR=1000
# Where the local audit log lives. Defaults to ~/.auto-broker-mcp.
# AUTOBROKER_MCP_HOME=

# --- Interactive Brokers (Client Portal API) ---
# Run IBKR's Client Portal Gateway yourself and log into it in a browser at
# https://localhost:5000 first; this server talks to it, not to IBKR directly.
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_MODE=paper
# IBKR_ACCOUNT_ID=
