# Copy to .env and fill in only the brokers you actually use, OR set these
# as the "env" block of this server's entry in your MCP client config
# (recommended — see README.md). Never commit a filled-in .env.

# --- Guardrails (apply to every broker) ---
FINEDU_MAX_PER_ORDER_EUR=250
FINEDU_MAX_PER_MONTH_EUR=1000
# Where the local audit log lives. Defaults to ~/.finedu-broker-mcp.
# FINEDU_MCP_HOME=

# --- Interactive Brokers (Client Portal API) ---
# Run IBKR's Client Portal Gateway yourself and log into it in a browser at
# https://localhost:5000 first; this server talks to it, not to IBKR directly.
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_MODE=paper
# IBKR_ACCOUNT_ID=

# --- Saxo Bank (OpenAPI) ---
# Token from your own Saxo developer application (developer.saxo).
SAXO_MODE=sim
SAXO_TOKEN=
# SAXO_ACCOUNT_KEY=

# --- Robinhood (UNOFFICIAL, EXPERIMENTAL — read the warning in
#     src/brokers/robinhood.ts and mcp/README.md before setting these) ---
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# ROBINHOOD_MFA_CODE=
ROBINHOOD_ACKNOWLEDGE_UNOFFICIAL_API=false
